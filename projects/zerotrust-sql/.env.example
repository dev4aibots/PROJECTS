# Local deterministic mode requires no secrets.
APP_MODE=deterministic
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Owner-managed live deployment only:
# The login must be a member of nl_query_ro, nl_audit_writer, and
# nl_rate_limiter; runtime assumes each least-privilege role per operation.
DATABASE_URL=
DATABASE_POOL_MAX_SIZE=3
DATABASE_POOL_TIMEOUT_SECONDS=5
AUTH_MODE=required
# Comma-separated, high-entropy bearer keys. Audit keys also permit queries.
QUERY_API_KEYS=
AUDIT_API_KEYS=
# Independent high-entropy keys for non-reversible audit and rate-limit hashes.
AUDIT_HASH_KEY=
RATE_LIMIT_HASH_KEY=
# Raw prompts and SQL are disabled in durable audit storage by default.
AUDIT_STORE_RAW_TEXT=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
GROQ_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
