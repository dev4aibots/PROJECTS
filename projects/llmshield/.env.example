# Local mode is deterministic and requires no provider key.
PROVIDER_MODE=deterministic
PII_POLICY=redact
MAX_OUTPUT_CHARS=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set PROVIDER_MODE=live and provide at least one key for hosted inference.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional Langfuse trace ingestion; failures are fail-open.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Apply migrations 001 and 002, then grant the server login membership in
# llmshield_log_writer and llmshield_rate_limiter before setting this URL.
DATABASE_URL=
DATABASE_POOL_MAX_SIZE=3
DATABASE_POOL_TIMEOUT_SECONDS=5

# Local mode is credential-free. Hosted/live mode must use required auth with
# distinct high-entropy scopes. Never expose these values through NEXT_PUBLIC_*.
AUTH_MODE=deterministic
GATEWAY_API_KEYS=
TELEMETRY_API_KEYS=
AUTH_FINGERPRINT_KEY=
RATE_LIMIT_HASH_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Reserved privacy switch. Plaintext logging is intentionally unsupported in v1.
LOG_PROMPTS=false
