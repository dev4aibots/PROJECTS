# ClientFlow environment (CF-03). Copy to .env.local for a real Supabase project.
# ONLY browser-safe variables exist here. A service-role / sb_secret_ key is never
# read by this app and is rejected by readAuthConfig() if it is pasted by mistake.
# Without these, / , /demo and /login still work; /login states what is missing.

# Project URL (https://<ref>.supabase.co, or http://127.0.0.1:54321 for a local stack)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional canonical origin used to build the OAuth callback URL behind proxies.
# Must also be listed in Supabase Auth > URL configuration > Redirect URLs as
# <origin>/auth/callback and <origin>/auth/recovery.
# NEXT_PUBLIC_APP_ORIGIN=https://clientflow.example.com
